function ajouterEvenement() {

    let date =
        document.getElementById("date").value;

    let evenement =
        document.getElementById("evenement").value;

    if (
        date === "" ||
        evenement.trim() === ""
    ) {
        return;
    }

    let element =
        document.createElement("div");

    element.className = "task";

    element.innerHTML =
        "📌 " + date + " — " + evenement;

    document
        .getElementById("listeEvenements")
        .appendChild(element);

    document.getElementById("date").value = "";
    document.getElementById("evenement").value = "";
}


