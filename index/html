function showPage(pageId) {

    const pages = document.querySelectorAll(".page");

    pages.forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById(pageId).classList.add("active");

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


// ===============================
// 🧮 CALCULATEUR DE MOYENNE
// ===============================

function ajouterMatiere() {

    let ligne = document.createElement("div");

    ligne.className = "matiere-ligne";

    ligne.innerHTML = `
        <input type="text" placeholder="Matière">
        <input type="number" placeholder="Devoir 1" min="0" max="20">
        <input type="number" placeholder="Devoir 2" min="0" max="20">
        <input type="number" placeholder="Composition" min="0" max="20">
        <input type="number" placeholder="Coefficient" min="1" value="1">
    `;

    document.getElementById("matieres").appendChild(ligne);
}


function calculerMoyenne() {

    let lignes = document.querySelectorAll(".matiere-ligne");

    let totalPoints = 0;
    let totalCoefficients = 0;

    lignes.forEach(ligne => {

        let inputs = ligne.querySelectorAll("input");

        let devoir1 = parseFloat(inputs[1].value);
        let devoir2 = parseFloat(inputs[2].value);
        let composition = parseFloat(inputs[3].value);
        let coefficient = parseFloat(inputs[4].value);

        if (
            !isNaN(devoir1) &&
            !isNaN(devoir2) &&
            !isNaN(composition) &&
            !isNaN(coefficient)
        ) {

            let moyenneDevoirs =
                (devoir1 + devoir2) / 2;

            let moyenneMatiere =
                (moyenneDevoirs + composition) / 2;

            totalPoints +=
                moyenneMatiere * coefficient;

            totalCoefficients += coefficient;
        }
    });

    if (totalCoefficients === 0) {

        document.getElementById("resultatMoyenne").innerHTML =
            "⚠️ Remplis au moins une matière.";

        return;
    }

    let moyenneGenerale =
        totalPoints / totalCoefficients;

    document.getElementById("resultatMoyenne").innerHTML =
        "🌸 Ta moyenne générale est : " +
        moyenneGenerale.toFixed(2) +
        " / 20";
}


// ===============================
// 📚 RÉVISIONS
// ===============================

function ajouterRevision() {

    let matiere =
        document.getElementById("matiere").value;

    let chapitre =
        document.getElementById("chapitre").value;

    if (
        matiere.trim() === "" ||
        chapitre.trim() === ""
    ) {

        alert(
            "⚠️ Remplis la matière et le chapitre !"
        );

        return;
    }

    let element =
        document.createElement("div");

    element.className = "task";

    element.innerHTML = `
        <input type="checkbox">
        <span>
            <strong>${matiere}</strong> — ${chapitre}
        </span>
    `;

    document
        .getElementById("listeRevision")
        .appendChild(element);

    document.getElementById("matiere").value = "";
    document.getElementById("chapitre").value = "";
}


// ===============================
// ✅ TÂCHES
// ===============================

function ajouterTache() {

    let tache =
        document.getElementById("nouvelleTache").value;

    if (tache.trim() === "") {

        alert("⚠️ Écris une tâche !");

        return;
    }

    let element =
        document.createElement("div");

    element.className = "task";

    element.innerHTML = `
        <input
            type="checkbox"
            onchange="terminerTache(this)"
        >

        <span>${tache}</span>

        <button onclick="supprimerTache(this)">
            🗑️
        </button>
    `;

    document
        .getElementById("listeTaches")
        .appendChild(element);

    document.getElementById("nouvelleTache").value = "";
}


function terminerTache(checkbox) {

    let texte =
        checkbox.nextElementSibling;

    if (checkbox.checked) {

        texte.style.textDecoration =
            "line-through";

        texte.style.opacity = "0.5";

    } else {

        texte.style.textDecoration =
            "none";

        texte.style.opacity = "1";
    }
}


function supprimerTache(bouton) {

    bouton.parentElement.remove();
}


// ===============================
// 📅 CALENDRIER
