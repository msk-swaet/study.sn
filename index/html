    `;
}


function mettreAJourMatieres() {

    let classe =
        document.getElementById("classeQuiz").value;

    let parcours =
        document.getElementById("parcoursQuiz").value;

    let selectMatiere =
        document.getElementById("matiereQuiz");

    selectMatiere.innerHTML =
        '<option value="">-- Choisir une matière --</option>';

    if (!matieresBase[classe]) {
        return;
    }

    let matieres =
        [...matieresBase[classe]];

    if (parcours === "bst") {

        matieres.push("Technologie");
        matieres.push("Économie familiale");
    }

    matieres.forEach(function(matiere) {

        let option =
            document.createElement("option");

        option.value = matiere;
        option.textContent = matiere;

        selectMatiere.appendChild(option);
    });
}


function ajouterMatiereQuiz() {

    let nouvelleMatiere =
        prompt(
            "📚 Écris le nom de la matière à ajouter :"
        );

    if (
        nouvelleMatiere &&
        nouvelleMatiere.trim() !== ""
    ) {

        let selectMatiere =
            document.getElementById("matiereQuiz");

        let option =
            document.createElement("option");

        option.value =
            nouvelleMatiere.trim();

        option.textContent =
            "✏️ " + nouvelleMatiere.trim();

        selectMatiere.appendChild(option);

        selectMatiere.value =
            nouvelleMatiere.trim();
    }
}


