    document.getElementById("choixParcours").style.display =
        "none";

    document.getElementById("matiereQuiz").innerHTML =
        '<option value="">-- Choisir d\'abord ton parcours --</option>';
}


function mettreAJourParcours() {

    let type =
        document.getElementById("typeEtablissement").value;

    let choixParcours =
        document.getElementById("choixParcours");

    let parcours =
        document.getElementById("parcoursQuiz");

    parcours.innerHTML =
        '<option value="">-- Choisir --</option>';

    if (type === "") {

        choixParcours.style.display =
            "none";

        return;
    }

    choixParcours.style.display =
        "block";

    parcours.innerHTML += `
        <option value="classique">
            🏫 Parcours classique
        </option>

        <option value="bst">
            🔬 Bloc scientifique et technologique
        </option>

        <option value="personnalise">
