// ===============================
// 🚀 COMMENCER LE QUIZ
// ===============================

function commencerQuiz() {

    let classe =
        document.getElementById("classeQuiz").value;

    let matiere =
        document.getElementById("matiereQuiz").value;

    let niveau =
        document.getElementById("niveauQuiz").value;

    if (
        classe === "" ||
        matiere === "" ||
        niveau === ""
    ) {

        document.getElementById("messageQuiz").innerHTML =
            "⚠️ Choisis ta classe, ta matière et ton niveau.";

        return;
    }

    let questionsDisponibles =
        banqueQuestions[classe] &&
        banqueQuestions[classe][matiere]
            ? banqueQuestions[classe][matiere]
            : [];

    if (questionsDisponibles.length === 0) {

        document.getElementById("messageQuiz").innerHTML =
            "📚 Les questions de cette matière sont encore en préparation.";

        return;
    }

    let questionsNiveau =
        questionsDisponibles.filter(
            question => question.niveau === niveau
        );

    if (questionsNiveau.length === 0) {

        questionsNiveau =
            questionsDisponibles;
    }

    quizQuestions =
        [...questionsNiveau]
        .sort(() => Math.random() - 0.5);

    quizIndex = 0;
    quizScore = 0;

    document.getElementById("messageQuiz").innerHTML = "";

    showPage("pageQuiz");

    afficherQuestionQuiz();
}


// ===============================
// 📖 AFFICHER UNE QUESTION
// ===============================

function afficherQuestionQuiz() {

    let zone =
        document.getElementById("zoneQuestionQuiz");

    if (quizIndex >= quizQuestions.length) {

        terminerQuiz();

        return;
    }

    let question =
        quizQuestions[quizIndex];

    let html = `
        <div class="card">

            <h3>
                Question ${quizIndex + 1}
                /
                ${quizQuestions.length}
            </h3>

            <p>
                <strong>
                    ${question.question}
                </strong>
            </p>
    `;

    question.options.forEach(
        (option, index) => {

            html += `
                <button
                    class="action reponseQuiz"
                    onclick="repondreQuiz(${index})"
                >
                    ${option}
                </button>
            `;
        }
    );

    html += `
            <div id="feedbackQuiz" class="result"></div>

        </div>
    `;

    zone.innerHTML = html;
}


// ===============================
// ✅ VÉRIFIER LA RÉPONSE
// ===============================

function repondreQuiz(index) {

    let question =
        quizQuestions[quizIndex];

    let boutons =
        document.querySelectorAll(".reponseQuiz");

    boutons.forEach(button => {
        button.disabled = true;
    });

    let feedback =
        document.getElementById("feedbackQuiz");

    if (index === question.reponse) {

        quizScore++;

        feedback.innerHTML =
            "🎉 Bonne réponse !";

    } else {

        feedback.innerHTML =
            "❌ Mauvaise réponse.<br>" +
            "La bonne réponse était : " +
            "<strong>" +
            question.options[question.reponse] +
            "</strong>";
    }

    feedback.innerHTML += `
        <br><br>

        <button
            class="action"
            onclick="questionSuivante()"
        >
            ➡️ Question suivante
        </button>
    `;
}


// ===============================
// ➡️ QUESTION SUIVANTE
// ===============================

function questionSuivante() {

    quizIndex++;

    afficherQuestionQuiz();
}


// ===============================
// 🏆 FIN DU QUIZ
// ===============================

function terminerQuiz() {

    let zone =
        document.getElementById("zoneQuestionQuiz");

    let pourcentage =
        Math.round(
            (quizScore / quizQuestions.length) * 100
        );

    zone.innerHTML = `
        <div class="card">

            <h3>🏆 Quiz terminé !</h3>

            <p>
                Tu as obtenu
                <strong>
                    ${quizScore} / ${quizQuestions.length}
                </strong>
            </p>

            <p>
                🌸 Score :
                <strong>${pourcentage}%</strong>
            </p>

            <button
                class="action"
                onclick="commencerQuiz()"
            >
                🔄 Recommencer
            </button>

        </div>
    `;
}

